@bot.tree.command(name="warnings", description="Check a user's warnings")
async def warnings(interaction: discord.Interaction, member: discord.Member):
    g = get_guild_data(interaction.guild)
    uid = str(member.id)
    warns = g["warnings"].get(uid, [])

    if not warns:
        return await interaction.response.send_message(f"{member} has no warnings.")

    msg = f"⚠️ **Warnings for {member}:**\n\n"
    now = time.time()
    for i, w in enumerate(warns, start=1):
        age = int((now - w["time"]) / 86400)
        msg += f"**{i}.** {w['reason']} — *{age} days old*\n"

    await interaction.response.send_message(msg)

@bot.tree.command(name="removewarning", description="Remove a specific warning")
@discord.app_commands.checks.has_permissions(moderate_members=True)
async def removewarning(interaction: discord.Interaction, member: discord.Member, number: int):
    g = get_guild_data(interaction.guild)
    uid = str(member.id)
    warns = g["warnings"].get(uid, [])

    if not warns:
        return await interaction.response.send_message("❌ This user has no warnings.", ephemeral=True)

    if number < 1 or number > len(warns):
        return await interaction.response.send_message("❌ Invalid warning number.", ephemeral=True)

    removed = warns.pop(number - 1)
    if not warns:
        del g["warnings"][uid]
    save()

    await interaction.response.send_message(f"🗑️ Removed warning #{number}: {removed['reason']}")

