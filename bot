active_polls = {}  # message_id : { "channel": channel_id, "votes": needed_votes }

@bot.tree.command(name="poll", description="Create a poll that triggers ERLC open announcement")
async def poll(interaction: discord.Interaction, question: str, votes: int):
    if not is_allowed("poll", interaction.user):
        return await interaction.response.send_message("❌ This command is disabled by the server owner.", ephemeral=True)

    embed = discord.Embed(
        title="📊 New Poll",
        description=f"**{question}**\n\n👍 = Yes\n👎 = No\n\nNeeded votes: **{votes}**",
        color=discord.Color.blue()
    )

    msg = await interaction.channel.send(embed=embed)
    await msg.add_reaction("👍")
    await msg.add_reaction("👎")

    active_polls[msg.id] = {
        "channel": interaction.channel.id,
        "votes": votes
    }

    await interaction.response.send_message("📌 Poll created!", ephemeral=True)

@bot.event
async def on_reaction_add(reaction, user):
    if user.bot:
        return

    msg = reaction.message
    if msg.id not in active_polls:
        return

    poll_data = active_polls[msg.id]

    if reaction.emoji == "👍":
        message = await msg.channel.fetch_message(msg.id)
        for react in message.reactions:
            if react.emoji == "👍":
                count = react.count - 1  # subtract bot
                if count >= poll_data["votes"]:
                    channel = msg.guild.get_channel(poll_data["channel"])
                    await channel.send(
                        "@everyone\n\n"
                        "**📢 ERLC Server is now OPEN!**\n"
                        "**Join Code: `WCLRP`**"
                    )
                    del active_polls[msg.id]
                break

