# -----------------------------
# WARNING EXPIRATION (TRUE 30 DAYS)
# -----------------------------
def cleanup_expired_warnings_for_guild(guild: discord.Guild):
    gid = str(guild.id)
    if gid not in data:
        return
    g = data[gid]
    if "warnings" not in g:
        return

    now = time.time()
    changed = False

    for uid in list(g["warnings"].keys()):
        original = g["warnings"][uid]
        filtered = [
            w for w in original
            if now - w.get("time", now) < 30 * 86400
        ]
        if len(filtered) != len(original):
            changed = True
        if filtered:
            g["warnings"][uid] = filtered
        else:
            del g["warnings"][uid]

    if changed:
        save()

# -----------------------------
# PER-SERVER DATA
# -----------------------------
def get_guild_data(guild: discord.Guild):
    gid = str(guild.id)
    if gid not in data:
        data[gid] = {}
    g = data[gid]

    g.setdefault("codes", {"FREE100": 1})
    g.setdefault("hours", {})
    g.setdefault("voice_join", {})
    g.setdefault("warnings", {})
    g.setdefault("allowed_commands", {})
    g.setdefault("welcome_channel", None)
    g.setdefault("welcome_message", "Welcome {user} to {server}!")
    g.setdefault("welcome_enabled", True)

    cleanup_expired_warnings_for_guild(guild)
    return g

# -----------------------------
# GLOBAL BLACKLIST CHECK
# -----------------------------
def is_globally_blacklisted(user: discord.Member):
    return str(user.id) in data.get("global_blacklist", [])

# -----------------------------
# AUTO-KICK BLACKLISTED USERS ON JOIN
# -----------------------------
@bot.event
async def on_member_join(member: discord.Member):
    if is_globally_blacklisted(member):
        try:
            await member.kick(reason="Globally blacklisted")
        except:
            pass
        return

    g = get_guild_data(member.guild)
    if not g.get("welcome_enabled", True):
        return

    channel_id = g.get("welcome_channel")
    message_template = g.get("welcome_message")

    if channel_id:
        channel = member.guild.get_channel(channel_id)
        if channel:
            message = message_template.replace("{user}", member.mention).replace("{server}", member.guild.name)
            await channel.send(message)

# -----------------------------
# AUTO-KICK BLACKLISTED USERS WHEN BOT JOINS A SERVER
# -----------------------------
@bot.event
async def on_guild_join(guild):
    for member in guild.members:
        if is_globally_blacklisted(member):
            try:
                await member.kick(reason="Globally blacklisted")
            except:
                pass

# -----------------------------
# COMMAND PERMISSION CHECK
# -----------------------------
def is_allowed(command_name, user: discord.Member):
    if is_globally_blacklisted(user):
        return False
    if user.guild_permissions.administrator:
        return True
    g = get_guild_data(user.guild)
    return g["allowed_commands"].get(command_name, True)

