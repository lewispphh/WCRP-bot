@bot.tree.command(name="stop_hours", description="Stop tracking and add hours")
async def stop_hours(interaction: discord.Interaction):
    if not is_allowed("stop_hours", interaction.user):
        return await interaction.response.send_message("❌ This command is disabled by the server owner.", ephemeral=True)

    g = get_guild_data(interaction.guild)
    uid = str(interaction.user.id)
    if uid not in g["voice_join"]:
        return await interaction.response.send_message("❌ You don't have a timer running.", ephemeral=True)
