class SetupButton(Button):
    def __init__(self, command_name, label):
        super().__init__(label=label, style=discord.ButtonStyle.primary)
        self.command_name = command_name

    async def callback(self, interaction: discord.Interaction):
        g = get_guild_data(interaction.guild)

        if self.command_name == "welcome":
            current = g.get("welcome_enabled", True)
            new_value = not current
            g["welcome_enabled"] = new_value
            save()
            self.label = f"welcome — {'🟢' if new_value else '🔴'}"
        else:
            current = g["allowed_commands"].get(self.command_name, True)
            new_value = not current
            g["allowed_commands"][self.command_name] = new_value
            save()
            self.label = f"{self.command_name} — {'🟢' if new_value else '🔴'}"

        await interaction.response.edit_message(
            content="⚙️ **Setup Dashboard**\nToggle which commands members can use:",
            view=self.view
        )

class SetupView(View):
    def __init__(self, owner_id: int, guild: discord.Guild):
        super().__init__(timeout=None)
        self.owner_id = owner_id
        self.guild_id = guild.id

        g = get_guild_data(guild)

        self.commands = [
            "hours", "start_hours", "stop_hours", "leaderboard",
            "redeem", "poll", "coinflip", "roll", "8ball",
            "welcome"
        ]

        for cmd in self.commands:
            if cmd == "welcome":
                status = g.get("welcome_enabled", True)
                label = f"welcome — {'🟢' if status else '🔴'}"
            else:
                status = g["allowed_commands"].get(cmd, True)
                label = f"{cmd} — {'🟢' if status else '🔴'}"
            self.add_item(SetupButton(cmd, label))

    async def interaction_check(self, interaction: discord.Interaction):
        if interaction.user.id != self.owner_id:
            await interaction.response.send_message(
                "❌ Only the person who opened this setup panel can use it.",
                ephemeral=True
            )
            return False
        return True

