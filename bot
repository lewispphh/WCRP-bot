@bot.tree.command(name="blacklist", description="Blacklist a user from ALL servers (Owner only)")
async def blacklist(interaction: discord.Interaction, user: discord.Member):
    if interaction.user.id != bot.owner_id:
        return await interaction.response.send_message("❌ Only the bot owner can do this.", ephemeral=True)

    uid = str(user.id)
    if uid in data["global_blacklist"]:
        return await interaction.response.send_message("❌ User already blacklisted.", ephemeral=True)

    data["global_blacklist"].append(uid)
    save()

    # Kick from all servers
    for guild in bot.guilds:
        member = guild.get_member(user.id)
        if member:
            try:
                await member.kick(reason="Globally blacklisted")
            except:
                pass

    await interaction.response.send_message(f"⛔ {user} has been globally blacklisted and kicked everywhere.")

@bot.tree.command(name="unblacklist", description="Remove a user from the global blacklist (Owner only)")
async def unblacklist(interaction: discord.Interaction, user: discord.Member):
    if interaction.user.id != bot.owner_id:
        return await interaction.response.send_message("❌ Only the bot owner can do this.", ephemeral=True)

    uid = str(user.id)
    if uid not in data["global_blacklist"]:
        return await interaction.response.send_message("❌ User is not blacklisted.", ephemeral=True)

    data["global_blacklist"].remove(uid)
    save()

    await interaction.response.send_message(f"✅ {user} has been removed from the global blacklist. They can join again.")

